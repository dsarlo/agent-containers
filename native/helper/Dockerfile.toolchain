# Immutable toolchain for the package-owned remote helper release artifacts.
# The digest and package versions reproduce the committed Bookworm GCC 12.2 pins.
FROM debian@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171

RUN rm -f /etc/apt/sources.list.d/debian.sources \
 && printf '%s\n' 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260824T000000Z bookworm main' > /etc/apt/sources.list \
 && apt-get -o Acquire::Check-Valid-Until=false update \
 && apt-get install -y --no-install-recommends \
      binutils=2.40-2 \
      coreutils=9.1-1 \
      file=1:5.44-3 \
      gcc=4:12.2.0-3 \
      gcc-aarch64-linux-gnu=4:12.2.0-3 \
      libc6-dev=2.36-9+deb12u14 \
      libc6-dev-arm64-cross=2.36-8cross1 \
      make=4.3-4.1 \
 && rm -rf /var/lib/apt/lists/*

CMD ["sh"]
