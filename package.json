{
  "name": "@dsarlo/arachne",
  "version": "0.1.0",
  "description": "Agent-harness-agnostic isolated Git workspaces with Dev Container runtimes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsarlo/arachne.git"
  },
  "homepage": "https://github.com/dsarlo/arachne#readme",
  "bugs": {
    "url": "https://github.com/dsarlo/arachne/issues"
  },
  "keywords": [
    "agents",
    "git-worktree",
    "devcontainers",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "arachne": "./dist/src/bin/arachne.js"
  },
  "files": [
    "dist/src",
    "*.md",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.17.0",
    "eslint": "^10.9.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "yaml": "^2.7.0"
  }
}
