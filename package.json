{
  "name": "@dsarlo/agent-containers",
  "version": "0.1.0",
  "description": "Isolated Git workspaces with Dev Container runtimes for coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsarlo/agent-containers.git"
  },
  "homepage": "https://github.com/dsarlo/agent-containers#readme",
  "bugs": {
    "url": "https://github.com/dsarlo/agent-containers/issues"
  },
  "keywords": [
    "agents",
    "git-worktree",
    "devcontainers",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "ac": "./dist/src/bin/agent-containers.js",
    "agent-containers": "./dist/src/bin/agent-containers.js"
  },
  "files": [
    "dist/src",
    "prebuilds",
    "*.md",
    "docs",
    "skills"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:native": "node-gyp rebuild",
    "native:prebuild": "prebuildify --napi --strip --out prebuilds",
    "native:verify-prebuilds": "node scripts/verify-native-prebuilds.mjs",
    "verify:native-packaging-contract": "node scripts/verify-native-packaging-contract.mjs",
    "test:native-packaging-contract": "node scripts/test-native-packaging-contract.mjs",
    "verify:native-state-lifecycle-contract": "node scripts/verify-native-state-lifecycle-contract.mjs",
    "test:native": "npm run build:native && npm run build && npm run verify:native-state-lifecycle-contract && node scripts/test-native.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:integration": "AGENT_CONTAINERS_REQUIRE_LIVE_INTEGRATION=1 npm run build && AGENT_CONTAINERS_REQUIRE_LIVE_INTEGRATION=1 node --import ./dist/test/setup.js --test dist/test/integration.test.js",
    "prepack": "npm run build && npm run native:verify-prebuilds"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.17.0",
    "eslint": "^10.9.1",
    "node-gyp": "^12.1.0",
    "prebuildify": "^6.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "node-gyp-build": "^4.8.4",
    "yaml": "^2.7.0"
  }
}
